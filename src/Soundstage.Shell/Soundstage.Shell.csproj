<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: Windows still has no first-class WPF tray API. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Soundstage.Shell</RootNamespace>
    <AssemblyName>Soundstage</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 hosts our approved HTML/CSS/JS UI as a native window. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <!-- NAudio drives WASAPI capture/render — the audio path into and out of our engine. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole UI is one self-contained HTML file; embed it so it ships inside the single .exe. -->
    <EmbeddedResource Include="web\index.html">
      <LogicalName>Soundstage.Shell.web.index.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Build the native engine (soundstage_engine) with CMake and ship it beside the app so the
       P/Invoke in SoundstageEngine resolves at runtime: soundstage_engine.dll on Windows (MSVC in
       CI), lib*.so/.dylib elsewhere. Verified on the Linux build host. -->
  <PropertyGroup>
    <!-- GetFullPath returns NO trailing separator; NormalizeDirectory would add one, and a trailing
         backslash before a closing quote escapes the quote on Windows (breaks the cmake command). -->
    <NativeEngineDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\native\soundstage-dsp'))</NativeEngineDir>
    <NativeEngineBuildDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)obj\native-engine'))</NativeEngineBuildDir>
  </PropertyGroup>

  <Target Name="BuildNativeEngine">
    <Exec Command="cmake -S &quot;$(NativeEngineDir)&quot; -B &quot;$(NativeEngineBuildDir)&quot; -DCMAKE_BUILD_TYPE=Release" />
    <Exec Command="cmake --build &quot;$(NativeEngineBuildDir)&quot; --config Release --target soundstage_engine" />
    <ItemGroup>
      <NativeEngineArtifact Include="$(NativeEngineBuildDir)\**\soundstage_engine.dll" />
      <NativeEngineArtifact Include="$(NativeEngineBuildDir)\**\libsoundstage_engine.so" />
      <NativeEngineArtifact Include="$(NativeEngineBuildDir)\**\libsoundstage_engine.dylib" />
    </ItemGroup>
  </Target>

  <!-- Copy the engine next to the app for a plain build / dotnet run. -->
  <Target Name="_CopyNativeEngineToOutput" AfterTargets="Build" DependsOnTargets="BuildNativeEngine">
    <Copy SourceFiles="@(NativeEngineArtifact)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Include the engine in publish output (single-file self-extract picks up native libs). -->
  <Target Name="_AddNativeEngineToPublish" BeforeTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="BuildNativeEngine">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(NativeEngineArtifact)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
