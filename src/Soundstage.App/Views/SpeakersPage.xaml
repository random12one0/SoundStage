<UserControl
    x:Class="Soundstage.App.Views.SpeakersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:Soundstage.App"
    xmlns:vm="clr-namespace:Soundstage.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SpeakersViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Margin="16,8,16,24">

            <!-- Header -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,12">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Speaker calibration" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="Balance your surround rig like an AV receiver — turn the subwoofer down, tame a too-loud centre, even out the surrounds. Every speaker starts at full level; drag one down to trim it. Cut-only, so it's always safe." />
                        </StackPanel>
                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ResetLevelsCommand}" Content="All to full" FontSize="11" Opacity="0.7" ToolTip="Reset every speaker to full level" />
                    </Grid>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{Binding DeviceName}" />
                        <Border Margin="10,0,0,0" Padding="7,1" VerticalAlignment="Center" CornerRadius="9" Background="#264CC2FF">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding LayoutLabel}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Not available -->
            <Border Margin="0,4,0,0" Padding="14" Background="#22000000" CornerRadius="8"
                    Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibilityInverse}}">
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Text="Speaker calibration needs a stereo, 5.1 or 7.1 output device. Pick your surround receiver as the default output and it'll show up here." />
            </Border>

            <!-- Channel levels -->
            <Border Margin="0,4,0,0" Padding="8,4" Background="#22000000" CornerRadius="8"
                    Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                <Slider Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                        Minimum="0" Maximum="12"
                                        SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding Cut}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="12" Opacity="0.8" Text="{Binding CutLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Margin="2,10,0,0" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                       Text="Tip: if a control doesn't seem to move the speaker you expect, your device may label its surrounds differently — a guided test-tone wizard is coming to confirm each one." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
