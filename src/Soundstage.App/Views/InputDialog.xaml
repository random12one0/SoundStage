<ui:FluentWindow
    x:Class="Soundstage.App.Views.InputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="380"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">
    <StackPanel Margin="20,12,20,20">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="PromptText" Margin="0,10,0,4" Opacity="0.75" />
        <ui:TextBox x:Name="ValueBox" />
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button x:Name="OkButton" Appearance="Primary" Content="OK" IsDefault="True" MinWidth="80" Click="OnOk" />
            <ui:Button Margin="8,0,0,0" Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
