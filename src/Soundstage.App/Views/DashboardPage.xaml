<UserControl
    x:Class="Soundstage.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:Soundstage.App"
    xmlns:controls="clr-namespace:Soundstage.App.Controls"
    xmlns:vm="clr-namespace:Soundstage.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <app:StringToVisibilityConverter x:Key="StringToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverse" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="16,8,16,24" HorizontalAlignment="Stretch">

            <!-- Preset row -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox
                        MinWidth="260"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0" Opacity="0.55" FontSize="11" VerticalAlignment="Center" Text="{Binding Category}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ui:Button Margin="8,0,0,0" Command="{Binding DuplicateCommand}" Content="Duplicate" ToolTip="Copy this preset so you can edit it" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding RenameCommand}" Content="Rename" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding DeleteCommand}" Content="Delete" />
                    <ui:Button Margin="6,0,0,0" Command="{Binding ImportFileCommand}" Content="Import…" ToolTip="Import Peace or AutoEq preset files" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="1"
                    MinWidth="150"
                    Padding="14,8"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsBypassed}"
                    ToolTip="Hear your audio with all Soundstage processing off (Ctrl+Alt+B)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Text="" />
                        <TextBlock Margin="8,0,0,0" Text="A/B Bypass" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <TextBlock
                Margin="2,8,0,0"
                Opacity="0.7"
                FontSize="12"
                Text="{Binding ImportStatus}"
                Visibility="{Binding ImportStatus, Converter={StaticResource StringToVisibility}}" />

            <!-- Safety strip -->
            <Border
                Margin="0,10,0,0"
                Padding="12,8"
                Background="#33C19C00"
                CornerRadius="6"
                Visibility="{Binding SafetyNote, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding SafetyNote}" TextWrapping="Wrap" />
            </Border>

            <!-- Response curve -->
            <Border
                Margin="0,12,0,0"
                Padding="10"
                Background="#22000000"
                CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="Frequency response" />
                        <TextBlock HorizontalAlignment="Right" Opacity="0.6" FontSize="12" Text="{Binding HeadroomSummary}" />
                    </Grid>
                    <controls:EqCurveControl
                        Height="200"
                        Margin="0,8,0,0"
                        Response="{Binding CurvePoints}" />
                </StackPanel>
            </Border>

            <!-- Editor -->
            <Border
                Margin="0,12,0,0"
                Padding="14"
                Background="#22000000"
                CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="Equalizer" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button Command="{Binding SetModeCommand}" CommandParameter="Parametric" Content="Parametric" FontSize="12" />
                            <ui:Button Margin="6,0,0,0" Command="{Binding SetModeCommand}" CommandParameter="Graphic10" Content="10-band" FontSize="12" />
                            <ui:Button Margin="6,0,0,0" Command="{Binding SetModeCommand}" CommandParameter="Graphic31" Content="31-band" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,10,0,0"
                        Opacity="0.7"
                        Text="This is a built-in preset. Duplicate it to make changes — your copy applies live as you edit."
                        TextWrapping="Wrap"
                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibilityInverse}}" />

                    <!-- Parametric editor -->
                    <StackPanel Visibility="{Binding IsParametric, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl Margin="0,8,0,0" IsEnabled="{Binding IsEditable}" ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Enabled}" />
                                        <ComboBox Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding Type}" />
                                        <ui:TextBox Grid.Column="2" Margin="4,0" VerticalAlignment="Center"
                                                    Text="{Binding FrequencyHz, StringFormat=0.#, UpdateSourceTrigger=LostFocus}"
                                                    ToolTip="Frequency (Hz)" />
                                        <Slider Grid.Column="3" Margin="8,0" VerticalAlignment="Center"
                                                Maximum="12" Minimum="-12"
                                                SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Value="{Binding GainDb}" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />
                                        <ui:TextBox Grid.Column="5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Text="{Binding Q, StringFormat=0.##, UpdateSourceTrigger=LostFocus}"
                                                    ToolTip="Q (width — higher is narrower)" />
                                        <ui:Button Grid.Column="6" Margin="6,0,0,0" Padding="6,4"
                                                   Command="{Binding DataContext.RemoveBandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Content="✕" FontSize="11" ToolTip="Remove band" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button
                            Margin="0,10,0,0"
                            Command="{Binding AddBandCommand}"
                            Content="Add band"
                            Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Graphic editor -->
                    <ItemsControl
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        IsEnabled="{Binding IsEditable}"
                        ItemsSource="{Binding GraphicBands}"
                        Visibility="{Binding IsParametric, Converter={StaticResource BoolToVisibilityInverse}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="27" Margin="1,0">
                                    <Slider
                                        Height="150"
                                        HorizontalAlignment="Center"
                                        Maximum="12"
                                        Minimum="-12"
                                        Orientation="Vertical"
                                        SmallChange="0.5"
                                        Value="{Binding Value}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="9.5"
                                        Opacity="0.65"
                                        Text="{Binding FrequencyLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- AutoEq -->
            <Border
                Margin="0,12,0,0"
                Padding="14"
                Background="#22000000"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="Headphone correction" />
                        <Run Text="{Binding AutoEqModelCount, Mode=OneWay, StringFormat=· {0:N0} models bundled from AutoEq}" FontWeight="Normal" Foreground="#88FFFFFF" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,8" FontSize="12" Opacity="0.65"
                               Text="Search your headphone model and add its correction preset — no downloads needed." />
                    <ui:TextBox
                        MaxWidth="420"
                        HorizontalAlignment="Left"
                        PlaceholderText="e.g. HD 650, AirPods Pro, DT 770"
                        Text="{Binding AutoEqQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl MaxHeight="260" Margin="0,8,0,0" ItemsSource="{Binding AutoEqResults}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Model}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.55" Text="{Binding Source}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Padding="10,4"
                                               Command="{Binding DataContext.AddAutoEqPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Content="Add" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
