<UserControl
    x:Class="Soundstage.App.Views.EffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:Soundstage.App"
    xmlns:vm="clr-namespace:Soundstage.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:EffectsViewModel}">

    <UserControl.Resources>
        <app:StringToVisibilityConverter x:Key="StringToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" Margin="16,8,16,24">

            <!-- Night mode -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,12">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Night mode" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="Quieter late-night listening: pulls down the bass that travels through walls and eases the overall level. 100% native — no plugins, so it can never interrupt your audio." />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:Button Margin="0,0,10,0" Command="{Binding ResetNightCommand}" Content="Reset" FontSize="11" Opacity="0.6" ToolTip="Back to defaults" />
                            <ui:ToggleSwitch IsChecked="{Binding NightEnabled}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0" IsEnabled="{Binding NightEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Intensity" />
                        <Slider Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Maximum="100" Minimum="0" Value="{Binding NightIntensity}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding NightIntensity, StringFormat={}{0:0}%}" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#E6C19C00" TextWrapping="Wrap"
                               Text="{Binding NightStatus}"
                               Visibility="{Binding NightStatus, Converter={StaticResource StringToVisibility}}" />
                    <Expander Margin="0,8,0,0" Header="Advanced">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Bass shelf corner" />
                                <Slider Grid.Column="1" Margin="12,0" Maximum="400" Minimum="40" Value="{Binding NightBassCorner}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding NightBassCorner, StringFormat={}{0:0} Hz}" />
                                <ui:Button Grid.Column="3" Margin="8,0,0,0" Padding="8,4" FontSize="11" Command="{Binding ResetBassCornerCommand}" Content="Reset"
                                           ToolTip="Let the intensity slider control the corner again" />
                            </Grid>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.55"
                                       Text="By default the intensity slider opens this up automatically — higher intensity removes more of the bass. Drag to pin it, or Reset to hand it back to intensity." TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Loudness -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Loudness compensation" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="At low volume your ears lose bass and treble first. This adds them back, tracking your volume — great together with night mode. (Subtle by nature: it only acts when the volume is turned down.)" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:Button Margin="0,0,10,0" Command="{Binding ResetLoudnessCommand}" Content="Reset" FontSize="11" Opacity="0.6" ToolTip="Back to defaults" />
                            <ui:ToggleSwitch IsChecked="{Binding LoudnessEnabled}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0" IsEnabled="{Binding LoudnessEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Intensity" />
                        <Slider Grid.Column="1" Margin="12,0" Maximum="100" Minimum="0" Value="{Binding LoudnessIntensity}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding LoudnessIntensity, StringFormat={}{0:0}%}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stereo width -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Stereo width" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="Spreads panned instruments further apart. 100% is untouched. Works on any output — it only widens the front left/right pair, so your centre, LFE and surround channels are never touched." />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:Button Margin="0,0,10,0" Command="{Binding ResetWidthCommand}" Content="Reset" FontSize="11" Opacity="0.6" ToolTip="Back to defaults" />
                            <ui:ToggleSwitch IsChecked="{Binding WidthEnabled}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0" IsEnabled="{Binding WidthEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Width" />
                        <Slider Grid.Column="1" Margin="12,0" Maximum="200" Minimum="0" Value="{Binding WidthPercent}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding WidthPercent, StringFormat={}{0:0}%}" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0" FontSize="12" Opacity="0.55" Text="Safe zone up to 120% — beyond that, centered vocals start to thin out." />
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#E6D83B01" TextWrapping="Wrap"
                               Text="{Binding WidthStatus}"
                               Visibility="{Binding WidthStatus, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Ambience (experimental, feature-flagged) -->
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding AmbienceVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Ambience" />
                            <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" Background="#446C2EB0" CornerRadius="4">
                                <TextBlock FontSize="10" Text="EXPERIMENTAL" />
                            </Border>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <ui:Button Margin="0,0,10,0" Command="{Binding ResetAmbienceCommand}" Content="Reset" FontSize="11" Opacity="0.6" ToolTip="Back to defaults" />
                            <ui:ToggleSwitch IsChecked="{Binding AmbienceEnabled}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,2,0,0" FontSize="12" Opacity="0.65" Text="A touch of room reverb for stereo music." />
                    <Grid Margin="0,12,0,0" IsEnabled="{Binding AmbienceEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="Intensity" />
                        <Slider Grid.Column="1" Margin="12,0" Maximum="100" Minimum="0" Value="{Binding AmbienceIntensity}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding AmbienceIntensity, StringFormat={}{0:0}%}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
