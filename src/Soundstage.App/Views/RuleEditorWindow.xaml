<ui:FluentWindow
    x:Class="Soundstage.App.Views.RuleEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:Soundstage.App"
    xmlns:vm="clr-namespace:Soundstage.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:RuleEditorViewModel}"
    Title="Automation"
    Width="600"
    Height="720"
    MinWidth="520"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <app:StringToVisibilityConverter x:Key="StringToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <app:EnumEqualsConverter x:Key="EnumEquals" />
        <app:StringEqualsConverter x:Key="StringEquals" />

        <!-- A plain selectable pill (no icon) for action/effect/channel choices. -->
        <Style x:Key="ChoicePill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="13,7" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334CC2FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A selectable pill (RadioButton) for the trigger kind -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="12,8" Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" CornerRadius="9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Ico" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{StaticResource SubtleTextBrush}" Text="{TemplateBinding Tag}" />
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334CC2FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A round day toggle (M T W …) -->
        <Style x:Key="DayChip" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}"
                                BorderThickness="1" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334CC2FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestChip" TargetType="ui:Button">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Automation" ShowMaximize="False" ShowMinimize="False" />

        <!-- Live plain-English preview -->
        <Border Grid.Row="1" Margin="20,4,20,10" Padding="16,14" CornerRadius="10" Background="#1F4CC2FF" BorderBrush="#334CC2FF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#4CC2FF" Text="&#xE945;" />
                <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding LiveSentence}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="20,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:TextBox PlaceholderText="Name (optional — we'll name it for you)" Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="2,18,0,8" Style="{StaticResource SectionTitle}" Text="When…" />
                <WrapPanel>
                    <RadioButton Style="{StaticResource Pill}" Tag="&#xE823;" Content="Schedule"
                                 IsChecked="{Binding TriggerKind, Converter={StaticResource EnumEquals}, ConverterParameter=Schedule}" />
                    <RadioButton Style="{StaticResource Pill}" Tag="&#xE71D;" Content="App plays audio"
                                 IsChecked="{Binding TriggerKind, Converter={StaticResource EnumEquals}, ConverterParameter=AudioApp}" />
                    <RadioButton Style="{StaticResource Pill}" Tag="&#xE7F3;" Content="Channel count"
                                 IsChecked="{Binding TriggerKind, Converter={StaticResource EnumEquals}, ConverterParameter=ChannelCount}" />
                    <RadioButton Style="{StaticResource Pill}" Tag="&#xE772;" Content="Output device"
                                 IsChecked="{Binding TriggerKind, Converter={StaticResource EnumEquals}, ConverterParameter=Device}" />
                </WrapPanel>

                <Border Margin="0,10,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- Schedule -->
                        <StackPanel Visibility="{Binding IsSchedule, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource DayChip}" Content="{Binding Label}" IsChecked="{Binding Selected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="From" />
                                <ui:TextBox Width="78" Margin="8,0" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="until" />
                                <ui:TextBox Width="78" Margin="8,0" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock VerticalAlignment="Center" FontSize="11.5" Opacity="0.5" Text="e.g. 10:00 PM → 6:00 AM (spans midnight)" />
                            </StackPanel>
                        </StackPanel>

                        <!-- App -->
                        <StackPanel Visibility="{Binding IsAudioApp, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="Which apps? Match the app that's playing audio. Comma-separated, partial names are fine." />
                            <ui:TextBox Margin="0,6,0,0" Text="{Binding ProcessesText, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AppSuggestions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Style="{StaticResource SuggestChip}" Content="{Binding}"
                                                   Command="{Binding DataContext.AppendAppCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="0,10,0,0" Padding="10,8" Background="#22000000" CornerRadius="6">
                                <TextBlock FontSize="11.5" Opacity="0.7" TextWrapping="Wrap"
                                           Text="How matching works: Soundstage looks at the apps currently playing sound and checks whether any name contains the text you typed, ignoring case — so &quot;spot&quot; matches Spotify and you don't need the exact process name or the .exe. List several, separated by commas, and the rule fires when any one of them is playing. Watching something in a browser? Match the browser itself (Chrome, Edge, Firefox) — that's the app holding the audio; YouTube/Netflix show up in the now-playing readout but aren't separate apps to match here." />
                            </Border>
                        </StackPanel>

                        <!-- Channels -->
                        <StackPanel Visibility="{Binding IsChannelCount, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <RadioButton Style="{StaticResource ChoicePill}" Content="Stereo (2.0)"
                                             IsChecked="{Binding ChannelCondition, Converter={StaticResource EnumEquals}, ConverterParameter=Stereo}" />
                                <RadioButton Style="{StaticResource ChoicePill}" Content="Surround (5.1 / 7.1)"
                                             IsChecked="{Binding ChannelCondition, Converter={StaticResource EnumEquals}, ConverterParameter=Multichannel}" />
                                <RadioButton Style="{StaticResource ChoicePill}" Content="Exactly…"
                                             IsChecked="{Binding ChannelCondition, Converter={StaticResource EnumEquals}, ConverterParameter=Exactly}" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,4,0,0"
                                        Visibility="{Binding IsExactChannels, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="exactly" />
                                <ui:TextBox Width="64" Margin="8,0" Text="{Binding ExactChannels, StringFormat=0}" />
                                <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="channels" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Device -->
                        <StackPanel Visibility="{Binding IsDevice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="12" Opacity="0.65" Text="Part of the output device's name (e.g. headphone, Onkyo)." />
                            <ui:TextBox Margin="0,6,0,0" Text="{Binding DevicePatternText, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DeviceSuggestions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Style="{StaticResource SuggestChip}" Content="{Binding}"
                                                   Command="{Binding DataContext.UseDeviceSuggestionCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                   CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="2,18,0,8" Style="{StaticResource SectionTitle}" Text="Then…" />
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource GlyphChip}" VerticalAlignment="Top">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="{StaticResource AccentBrush}" Text="{Binding Glyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <!-- Action kind — tap to choose (no dropdowns) -->
                                        <WrapPanel>
                                            <RadioButton Style="{StaticResource ChoicePill}" Content="Switch preset"
                                                         IsChecked="{Binding Kind, Converter={StaticResource StringEquals}, ConverterParameter=Switch preset}" />
                                            <RadioButton Style="{StaticResource ChoicePill}" Content="Turn effect on/off"
                                                         IsChecked="{Binding Kind, Converter={StaticResource StringEquals}, ConverterParameter=Turn effect on/off}" />
                                            <RadioButton Style="{StaticResource ChoicePill}" Content="Set effect intensity"
                                                         IsChecked="{Binding Kind, Converter={StaticResource StringEquals}, ConverterParameter=Set effect intensity}" />
                                        </WrapPanel>

                                        <!-- Switch preset -->
                                        <ComboBox Margin="0,6,0,0" MinWidth="220" HorizontalAlignment="Left" DisplayMemberPath="Name"
                                                  ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                                  Visibility="{Binding IsPresetKind, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- Turn effect on/off -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEnabledKind, Converter={StaticResource BoolToVisibility}}">
                                            <WrapPanel>
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Night mode" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=NightMode}" />
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Loudness" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Loudness}" />
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Stereo width" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=StereoWidth}" />
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Ambience" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Ambience}" />
                                            </WrapPanel>
                                            <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding EffectOn}" OnContent="On" OffContent="Off" />
                                        </StackPanel>

                                        <!-- Set effect intensity -->
                                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsIntensityKind, Converter={StaticResource BoolToVisibility}}">
                                            <WrapPanel>
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Night mode" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=NightMode}" />
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Loudness" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Loudness}" />
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Stereo width" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=StereoWidth}" />
                                                <RadioButton Style="{StaticResource ChoicePill}" Content="Ambience" IsChecked="{Binding Effect, Converter={StaticResource EnumEquals}, ConverterParameter=Ambience}" />
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Slider Width="180" VerticalAlignment="Center" Maximum="100" Minimum="0" Value="{Binding Intensity}" />
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Intensity, StringFormat={}{0:0}%}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <ui:Button Grid.Column="2" VerticalAlignment="Top" Padding="7,4" FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE711;"
                                               ToolTip="Remove this action"
                                               Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button HorizontalAlignment="Left" Command="{Binding AddActionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Text="&#xE710;" />
                        <TextBlock Margin="7,0,0,0" Text="Add another action" />
                    </StackPanel>
                </ui:Button>

                <ui:InfoBar Margin="0,12,0,8" Severity="Error" IsOpen="True"
                            Message="{Binding ValidationError}"
                            Visibility="{Binding ValidationError, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="20,10,20,16" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button MinWidth="100" Appearance="Primary" Click="OnSave" Content="Save" IsDefault="True" />
            <ui:Button MinWidth="100" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
