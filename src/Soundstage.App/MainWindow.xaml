<ui:FluentWindow
    x:Class="Soundstage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:Soundstage.App"
    xmlns:vm="clr-namespace:Soundstage.App.ViewModels"
    Title="Soundstage"
    Width="1180"
    Height="780"
    MinWidth="940"
    MinHeight="620"
    d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <app:StringToVisibilityConverter x:Key="StringToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Command="{Binding UndoCommand}" Gesture="Ctrl+Z" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Soundstage" />

        <!-- Attention banners -->
        <StackPanel Grid.Row="1">
            <Border
                Background="#33D83B01"
                Padding="16,10"
                Visibility="{Binding ShowApoMissingBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Equalizer APO was not found on this PC — Soundstage needs it to shape your audio." />
                    <ui:Button Margin="12,0,0,0" Command="{Binding OpenDiagnosticsCommand}" Content="See what to do" />
                </StackPanel>
            </Border>
            <Border
                Background="#332E6BE6"
                Padding="16,10"
                Visibility="{Binding ShowTakeoverBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Soundstage isn't controlling Equalizer APO yet. Your current config will be backed up first." />
                    <ui:Button Margin="12,0,0,0" Appearance="Primary" Command="{Binding TakeOwnershipCommand}" Content="Take control" />
                </StackPanel>
            </Border>
            <Border
                Background="#264CC2FF"
                Padding="16,10"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentBrush}" Text="&#xE895;" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="A new version of Soundstage is ready —" />
                        <Run FontWeight="SemiBold" Text="{Binding UpdateBannerText, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button Margin="12,0,0,0" Appearance="Primary" Command="{Binding OpenUpdateSettingsCommand}" Content="View update" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Nav rail + page -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="8,4,0,8">
                <StackPanel Margin="14,4,0,10" Orientation="Horizontal">
                    <Border
                        Width="26"
                        Height="26"
                        Background="{StaticResource AccentGradient}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="#0B0B10"
                            Text="&#xE9E9;" />
                    </Border>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="Soundstage" />
                </StackPanel>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource NavItemContainer}"
                    ItemsSource="{Binding NavItems}"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="22"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="16"
                                    Text="{Binding Glyph}" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Grid Grid.Column="1" Margin="4,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Persistent toolbar: Undo + A/B bypass reachable from every page -->
                <StackPanel Grid.Row="0" Margin="0,0,4,6" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Padding="10,6" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="Undo your last change (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Text="&#xE7A7;" />
                            <TextBlock Margin="7,0,0,0" Text="Undo" />
                        </StackPanel>
                    </ui:Button>
                    <ToggleButton Margin="8,0,0,0" Padding="12,6" IsChecked="{Binding IsBypassed}"
                                  Command="{Binding ToggleBypassCommand}"
                                  ToolTip="Hear your audio with all Soundstage processing off (Ctrl+Alt+B)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Text="&#xE8AB;" />
                            <TextBlock Margin="7,0,0,0" Text="A/B Bypass" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
            </Grid>

            <!-- Confirm-or-revert toast -->
            <Border
                Grid.Column="1"
                MaxWidth="440"
                Margin="0,18,0,0"
                Padding="18,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#F0202028"
                BorderBrush="#554CC2FF"
                BorderThickness="1"
                CornerRadius="10"
                DataContext="{Binding RevertToast}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.45" ShadowDepth="4" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Keep this sound?" />
                    <TextBlock Margin="0,4,0,10" Opacity="0.75" TextWrapping="Wrap">
                        <Run Text="If you don't confirm, the previous sound comes back in" />
                        <Run FontWeight="SemiBold" Text="{Binding SecondsRemaining, Mode=OneWay}" />
                        <Run Text="s — so a bad setting can never leave you without audio." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding KeepCommand}" Content="Keep it" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding RevertNowCommand}" Content="Revert now" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status readout -->
        <Border
            Grid.Row="3"
            Padding="16,7"
            Background="#22000000"
            DataContext="{Binding StatusBar}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="9"
                        Height="9"
                        VerticalAlignment="Center"
                        Fill="#E81123"
                        Visibility="{Binding IsClipping, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DeviceName}" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        Text="{Binding ChannelText}"
                        ToolTip="Your output device's speaker configuration — what Windows mixes everything to. Stereo content (like Spotify) still shows the full layout here; the receiver/Atmos handles the upmix." />
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Opacity="0.75" Text="{Binding FormatText}" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        Text="{Binding SpatialText}"
                        Visibility="{Binding SpatialText, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#7ACC7A"
                        Text="{Binding NowPlayingText}"
                        ToolTip="Apps currently playing audio (detected live — the same signal automations use)"
                        Visibility="{Binding NowPlayingText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border
                        Margin="0,0,12,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="#44D83B01"
                        CornerRadius="4"
                        Visibility="{Binding AutomationsPaused, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11" Text="AUTOMATIONS PAUSED" />
                    </Border>
                    <Border
                        Margin="0,0,12,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="#446C6C6C"
                        CornerRadius="4"
                        Visibility="{Binding IsBypassed, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="11" Text="BYPASSED" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.75"
                        Text="{Binding HeadroomText}"
                        Visibility="{Binding HeadroomText, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PresetText}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Text="{Binding AttributionText}"
                        Visibility="{Binding AttributionText, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
