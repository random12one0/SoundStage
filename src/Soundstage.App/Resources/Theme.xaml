<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Soundstage accent + surface palette -->
    <Color x:Key="AccentColor">#4CC2FF</Color>
    <Color x:Key="AccentColorDim">#2E9BD6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentBrushDim" Color="{StaticResource AccentColorDim}" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4CC2FF" />
        <GradientStop Offset="1" Color="#9A7BFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#73FFFFFF" />

    <!-- A soft, rounded surface card used across every page -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Section heading: small, quiet, uppercase-ish -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="SectionSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Navigation rail item: accent pill + glyph, animated selection -->
    <Style x:Key="NavItemContainer" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Bd"
                        Margin="6,2"
                        Padding="10,9"
                        Background="Transparent"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="Pill"
                                Grid.Column="0"
                                Width="3"
                                Height="18"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="2"
                                Opacity="0" />
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small circular glyph chip used on effect/automation cards -->
    <Style x:Key="GlyphChip" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="#264CC2FF" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

</ResourceDictionary>
