<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soundstage.App</RootNamespace>
    <AssemblyName>Soundstage</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>soundstage.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soundstage.Core\Soundstage.Core.csproj" />
    <ProjectReference Include="..\Soundstage.Windows\Soundstage.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled Airwindows (MIT) VST2 rack, embedded in the app. The portable release ships a single
         .exe, so we can't drop loose DLLs beside it; instead the app self-extracts these to the
         stable per-user plugin folder on demand, giving Equalizer APO a real path it can load. -->
    <EmbeddedResource Include="plugins/*.dll">
      <LogicalName>Soundstage.Plugins.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
